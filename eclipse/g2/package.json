    "pack": "npm run build && evenhub pack app.json dist -o eclipse.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
